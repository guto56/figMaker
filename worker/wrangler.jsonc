{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapfig",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "762fe93850d238b22cac17ead40753c7",
  "workers_dev": true,
  "routes": [
    { "pattern": "zapfig.site", "custom_domain": true },
    { "pattern": "www.zapfig.site", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/seed/*", "!/brand/*", "!/og.png", "!/icon-192.png", "!/icon-512.png", "!/apple-touch-icon.png", "!/favicon-32.png", "!/favicon.ico", "!/manifest.webmanifest"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "zapfig", "database_id": "002935f0-caaf-4ebd-8584-abfaac9f0e05", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "FILES", "id": "a9bb3613faef448a86ed7c7e60f47acd" }],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "PROXY_LIMIT", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
  ],
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "WA_NUMBER": "5565992463819" },
  "durable_objects": { "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],
  "observability": { "enabled": true }
}
